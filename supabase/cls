CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  INSERT INTO public.profiles(id, full_name, email)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'full_name', ''),
    NEW.email
  )
  ON CONFLICT (id) DO NOTHING;
  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.record_stock_movement(
  p_variant_id uuid,
  p_movement_type text,
  p_quantity integer,
  p_batch_id uuid DEFAULT NULL,
  p_warehouse_id uuid DEFAULT NULL,
  p_reference text DEFAULT NULL,
  p_notes text DEFAULT NULL
)
RETURNS public.product_variants
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'pg_catalog', 'public'
AS $function$
DECLARE
  v public.product_variants;
  ws public.warehouse_stock;
  v_new_on_hand integer;
BEGIN
  IF auth.uid() IS NULL OR NOT (
    public.has_role('super_admin'::app_role)
    OR public.has_role('manager'::app_role)
    OR public.has_role('inventory_officer'::app_role)
  ) THEN
    RAISE EXCEPTION 'inventory authorization required';
  END IF;
  IF p_quantity = 0 THEN RAISE EXCEPTION 'quantity must not be zero'; END IF;
  IF p_movement_type NOT IN (
    'purchase','sale','return','damage','expiry','adjustment',
    'transfer','opening','reservation','release'
  ) THEN
    RAISE EXCEPTION 'invalid movement type';
  END IF;

  SELECT * INTO v FROM public.product_variants WHERE id = p_variant_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'variant not found'; END IF;

  IF p_movement_type IN ('reservation','release') THEN
    RAISE EXCEPTION 'use order reservation operations for reservation/release';
  END IF;

  IF p_warehouse_id IS NOT NULL THEN
    SELECT * INTO ws FROM public.warehouse_stock
    WHERE warehouse_id = p_warehouse_id AND product_variant_id = p_variant_id
    FOR UPDATE;
    IF NOT FOUND THEN
      IF p_quantity < 0 THEN RAISE EXCEPTION 'warehouse stock record not found'; END IF;
      INSERT INTO public.warehouse_stock(warehouse_id, product_variant_id, on_hand, reserved)
      VALUES (p_warehouse_id, p_variant_id, p_quantity, 0)
      RETURNING * INTO ws;
    ELSE
      IF ws.on_hand + p_quantity < ws.reserved THEN
        RAISE EXCEPTION 'stock cannot fall below reserved quantity';
      END IF;
      UPDATE public.warehouse_stock
      SET on_hand = on_hand + p_quantity, updated_at = now()
      WHERE id = ws.id;
    END IF;

    SELECT COALESCE(SUM(on_hand),0) INTO v_new_on_hand
    FROM public.warehouse_stock WHERE product_variant_id = p_variant_id;
    UPDATE public.product_variants
    SET stock_quantity = v_new_on_hand, updated_at = now()
    WHERE id = p_variant_id RETURNING * INTO v;
  ELSE
    IF v.stock_quantity + p_quantity < 0 THEN RAISE EXCEPTION 'insufficient stock'; END IF;
    UPDATE public.product_variants
    SET stock_quantity = stock_quantity + p_quantity, updated_at = now()
    WHERE id = p_variant_id RETURNING * INTO v;
  END IF;

  INSERT INTO public.stock_movements(
    product_variant_id, batch_id, warehouse_id, movement_type,
    quantity, reference, notes, created_by
  ) VALUES (
    p_variant_id, p_batch_id, p_warehouse_id, p_movement_type,
    p_quantity, p_reference, p_notes, auth.uid()
  );
  RETURN v;
END;
$function$;

